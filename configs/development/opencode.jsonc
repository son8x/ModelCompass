    // ─── xKiro Max (gói $20/tháng - model paid) ────────────────────
    //  key: XTROUTER_API_KEY (cùng key, đã nâng cấp lên Max 16/09/2026)
    //  Gói Max phủ model "paid" (probe thực tế 25/09). 4 bậc sức mạnh:
    //    [L] Nhẹ·Nhanh·Rẻ → [B] Đa dụng → [A] Mạnh → [S] Flagship.
    //  Giá trong "name" = USD/1M token, lấy từ GET /v1/models (catalog live
    //  25/09). Trên gói Max các model này tính theo allowance $264/tuần
    //  (không trừ per-token); giá hiển thị để ước lượng khi nạp thêm wallet.
    //  ⚠️ KHÔNG dùng được trên gói Max (403, cần nạp wallet / Ultra/Power):
    //     Kimi (k2.5/2.6/2.7-code/k3), Grok (4.5/4.6/build), DeepSeek (v4-pro-0813,
    //     v4-flash-0731, v4-flash-vision-exp, v4.1-flash), Qwen3.5+/3.6+/3.7±/3.8-max,
    //     MiniMax (m2.5/m2.7/m3), Tencent hy3/hy4, Longcat, Muse-Spark,
    //     gpt-6-astra, claude-fable-5-1 — đã gỡ khỏi danh sách.
    //  Đang lỗi tạm phía xKiro (vẫn trong danh sách): gpt-5.5 (ERR),
    //     gpt-5.6-sol (500), nemotron-3-nano + llama-49b (410 routing).
    "2-xkiro-max": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "2. xKiro Max — 62 model (+8 · gỡ: glm-4.5, glm-4.5-x, glm-4.6)",
      "options": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XTROUTER_API_KEY}"
      },
      "models": {
        //  SẮP XẾP 4 NHÓM SỨC MẠNH (probe thực tế 25/09/2026):
        //  [L] → [B] → [A] → [S] (rẻ trước, mạnh sau), trong nhóm ưu tiên
        //  model mạnh/nhanh nhất lên trước. Tên hiển thị:
        //  [tier] Model · ghi chú ngắn. ⚠️ release_date = KHOÁ SẮP XẾP TỔNG HỢP.
        // ── [L] Nhẹ·Nhanh·Rẻ — tác vụ đơn giản, chạy nhiều ──
        "nvidia/nemotron-3-super": { "name": "[L] Nemotron 3 Super · $0.08/$0.45 · 1M · code", "release_date": "2099-10-31" },
        "nvidia/nemotron-3-nano-omni": { "name": "[L] Nemotron 3 Nano Omni · $0.05/$0.20 · vision", "release_date": "2099-10-29" },
        "openai/gpt-5.4-mini": { "name": "[L] GPT-5.4 Mini · $0.75/$4.50 · 400K · nhẹ", "release_date": "2099-10-28" },
        "openai/gpt-6-luna": { "name": "[L] GPT-6 Luna · $0.10/$0.50 · reasoning/vision", "release_date": "2099-10-27" },
        "openai/gpt-5.6-luna": { "name": "[L] GPT-5.6 Luna · $0.10/$0.60 · reasoning/vision", "release_date": "2099-10-26" },
        "anthropic/claude-haiku-4.5": { "name": "[L] Claude Haiku 4.5 · $1.00/$5.00 · nhanh", "release_date": "2099-10-25" },
        "z-ai/glm-5.3-flash": { "name": "[L] GLM-5.3 Flash · $0.15/$0.50 · vision", "release_date": "2099-10-24" },
        "z-ai/glm-5-turbo": { "name": "[L] GLM-5 Turbo · $1.20/$4.00 · nhanh", "release_date": "2099-10-23" },
        "google/gemini-2.5-flash": { "name": "[L] Gemini 2.5 Flash · $0.30/$2.50 · 1M · nhanh", "release_date": "2099-10-22" },
        "google/gemini-3-flash": { "name": "[L] Gemini 3 Flash · $0.75/$3.75 · 1M · nhanh", "release_date": "2099-10-21" },
        "xiaomi/mimo-v2.6-flash": { "name": "[L] MiMo V2.6 Flash · $0.14/$0.28 · 1M", "release_date": "2099-10-20" },
        "xiaomi/mimo-v2.5": { "name": "[L] MiMo V2.5 · $0.14/$0.28 · 1M", "release_date": "2099-10-19" },
        "z-ai/glm-4.5-flash": { "name": "[L] GLM-4.5 Flash · $0.20/$1.10 · nhẹ", "release_date": "2099-10-18" },
        "z-ai/glm-4.5-air": { "name": "[L] GLM-4.5 Air · $0.13/$0.85 · nhẹ", "release_date": "2099-10-17" },
        "z-ai/glm-4.5-airx": { "name": "[L] GLM-4.5 AirX · $1.10/$4.50 · nhẹ", "release_date": "2099-10-16" },
        "z-ai/glm-4.5v": { "name": "[L] GLM-4.5V · $0.60/$1.80 · vision", "release_date": "2099-10-15" },
        "z-ai/glm-4.6v-flash": { "name": "[L] GLM-4.6V Flash · $0.04/$0.40 · vision/nhanh", "release_date": "2099-10-14" },
        "z-ai/glm-4.6v-flashx": { "name": "[L] GLM-4.6V FlashX · $0.04/$0.40 · vision/nhanh", "release_date": "2099-10-13" },
        "z-ai/glm-5v-turbo": { "name": "[L] GLM-5V Turbo · $1.20/$4.00 · vision/nhanh", "release_date": "2099-10-12" },
        "minimax/minimax-m2": { "name": "🆕 [L] MiniMax M2 · $0.30/$1.20 · 204.8K", "release_date": "2099-10-08" },
        "minimax/minimax-m2.1": { "name": "🆕 [L] MiniMax M2.1 · $0.30/$1.20 · 204.8K", "release_date": "2099-10-07" },
        "minimax/minimax-m2.5": { "name": "🆕 [L] MiniMax M2.5 · $0.30/$1.20 · 204.8K", "release_date": "2099-10-06" },
        "minimax/minimax-m2.7": { "name": "🆕 [L] MiniMax M2.7 · $0.30/$1.20 · 204.8K", "release_date": "2099-09-03" },
        "minimax/minimax-m3": { "name": "🆕 [L] MiniMax M3 · $0.30/$1.20 · 1M", "release_date": "2099-09-22" },
        // ── [B] Đa dụng giá tốt — chat hàng ngày, việc chung ──
        "nvidia/nemotron-3-ultra": { "name": "[B] Nemotron 3 Ultra · $0.60/$2.40 · 1M · mạnh", "release_date": "2099-10-11" },
        "google/gemini-2.5-pro": { "name": "[B] Gemini 2.5 Pro · $1.25/$10.00 · 1M", "release_date": "2099-10-09" },
