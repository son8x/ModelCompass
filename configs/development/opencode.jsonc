        "z-ai/glm-4.7-flashx": { "name": "[B] GLM-4.7 FlashX · $0.37/$1.25 · nhanh", "release_date": "2099-10-02" },
        "z-ai/glm-5": { "name": "[B] GLM-5 · $0.60/$1.92", "release_date": "2099-10-01" },
        "z-ai/glm-5.1": { "name": "[B] GLM-5.1 · $1.40/$4.40", "release_date": "2099-09-30" },
        "z-ai/glm-5.2": { "name": "[B] GLM-5.2 · $0.25/$3.99 · 1M", "release_date": "2099-09-29" },
        "xiaomi/mimo-v2.6-pro": { "name": "[B] MiMo V2.6 Pro · $0.435/$0.87 · 1M", "release_date": "2099-09-28" },
        "xiaomi/mimo-v2.5-pro": { "name": "[B] MiMo V2.5 Pro · $0.435/$0.87 · 1M", "release_date": "2099-09-27" },
        "minimax/minimax-m2.1-highspeed": { "name": "🆕 [B] MiniMax M2.1 Highspeed · $0.60/$2.40 · 204.8K", "release_date": "2099-09-02" },
        "minimax/minimax-m2.5-highspeed": { "name": "🆕 [B] MiniMax M2.5 Highspeed · $0.60/$2.40 · 204.8K", "release_date": "2099-09-01" },
        "minimax/minimax-m2.7-highspeed": { "name": "🆕 [B] MiniMax M2.7 Highspeed · $0.60/$2.40 · 204.8K", "release_date": "2099-09-13" },
        // ── [A] Mạnh đa dụng — agent, coding sâu, luận văn ──
        "google/gemini-3.1-pro": { "name": "[A] Gemini 3.1 Pro · $2.00/$12.00 · 1M · mạnh", "release_date": "2099-09-26" },
        "google/gemini-3.5-flash": { "name": "[A] Gemini 3.5 Flash · $1.50/$9.00 · 1M", "release_date": "2099-09-25" },
