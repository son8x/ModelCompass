// ═══════════════════════════════════════════════════════════════════
//  MODEL COMPASS — DEVELOPMENT CONFIG (BẢN ĐANG PHÁT TRIỂN)
// ═══════════════════════════════════════════════════════════════════
//  📌 Mục đích: nơi bạn SOẠN THỬ cấu hình mới cho opencode.
//  - File này KHÔNG được dùng trực tiếp bởi opencode đang chạy.
//  - Mọi thay đổi ở đây chưa đụng tới phiên làm việc hiện tại.
//  - Chỉ sau khi TEST OK (scripts/test/Test-ModelConnectivity.ps1 + dùng thử)
//    mới Promote lên /configs/production bằng scripts/config/Publish-Config.ps1.
//
//  ⚠️ Quy ước:
//    - KHÔNG nhét API key thật vào file. Luôn dùng {env:BIEN_MOI_TRUONG}.
//    - Chạy lại script validate trước khi publish.
//
//  🧭 Cách dùng:
//  1. Copy block "provider" từ /configs/presets/*.jsonc (hoặc viết tay).
//  2. Đổi "model" mặc định theo nhu cầu.
//  3. PS scripts/config/Publish-Config.ps1   (validate -> promote lên production)
//  4. Restart opencode để nạp cấu hình mới.
// ═══════════════════════════════════════════════════════════════════
{
  "$schema": "https://opencode.ai/config.json",

  // Model mặc định khi mở opencode (provider/model-id).
  // 👉 Giữ free (đã test OK): 1-xkiro-free/qwen/qwen3.8-max:free.
  //    Muốn dùng model gói Max, đổi sang "2-xkiro-max/<model-id>".
  //    Để biết model nào nhanh/ổn, chạy:
  //    PS scripts/test/Test-ModelConnectivity.ps1 -ConfigPath .\configs\development\opencode.jsonc
  //
  //  🎯 THỨ TỰ HIỂN THỊ TRONG /model = SẮP XẾP THEO KEY (provider id)
  //     (build opencode này xếp nhóm provider theo key/name theo bảng chữ cái,
  //     nên PHẢI đánh số 1-, 2-, … ở đầu key VÀ name mỗi provider).
  //     Muốn đổi thứ tự: chỉ cần sửa lại số, không cần di chuyển block.
  //     Thứ tự ưu tiên hiện tại:
  //       1-xkiro-free → 2-xkiro-max → 3-omniroute-free
  //       → 4-openrouter-free → 5-9router → 6-teamoRouter
  //
  //  🎯 THỨ TỰ MODEL TRONG MỖI NHÓM = sort theo "release_date" GIẢM DẦN (rồi name A→Z),
  //     KHÔNG theo thứ tự khai báo. Các provider xKiro gán release_date tổng hợp (2099-…)
  //     làm khoá sắp xếp — xem ghi chú trong block "provider" bên dưới.
  "model": "1-xkiro-free/qwen/qwen3.8-max:free",

  // Plugin OmniRoute: router model nội bộ (chạy local tại cổng 20217).
  "plugin": [
    [
      "./plugins/omniroute/dist/index.js",
      {
        "providerId": "omniroute",
        "baseURL": "http://127.0.0.1:20217",
        "features": { "logLevel": "error" }
      }
    ]
  ],

  "provider": {
    // ─── xKiro Free (model miễn phí trên mọi gói) ─────────────────
    //  key: XTROUTER_API_KEY
    //  Lưu ý: danh sách dưới = catalog access_tier "free" chụp từ API 21/09/2026.
    //  Một số model đang lỗi phía xKiro (thử thực tế 21/09): minimax-m3:free,
    //  minimax-m2.7:free, minimax-m2.5-highspeed:free → HTTP 500.
    "1-xkiro-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "1. xKiro Free — 55 model (+1 · gỡ: deepseek-v4-pro, minimax-m3:free, deepseek-v4.1-flash:free, deepseek-v4-flash, deepseek-v3.2, deepseek-chat-v3.1, minimax-m2.7-highspeed:free, minimax-m2.7:free, minimax-m2.5-highspeed:free, minimax-m2.5:free, minimax-m2.1-highspeed:free, minimax-m2.1:free, minimax-m2:free, mimo-v2.6-flash:free)",
      "options": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XTROUTER_API_KEY}"
      },
      "models": {
        // (sắp theo độ mạnh giảm dần: reasoning/code mạnh → lite/small)
        // ⚠️ opencode KHÔNG giữ thứ tự khai báo: trong /model nó tự sort theo
        //    release_date GIẢM DẦN rồi mới tới name (A→Z). Các release_date dưới
        //    đây là KHOÁ SẮP XẾP TỔNG HỢP (năm 2099, không phải ngày phát hành
        //    thật) — model có date LỚN NHẤT hiện trên cùng. Muốn chèn/đổi vị trí:
        //    gán date nằm giữa 2 date lân cận. Chi tiết: docs/providers-and-models.md §6.
        //  Ghi chú từng model = thế mạnh/lĩnh vực (capabilities catalog xKiro 21/09).
        //  ⚠️ xKiro đã ĐƯA LẠI 5 model DeepSeek vào tier free (probe 200 OK 21/09):
        //    deepseek-v4-pro, deepseek-v4-flash, deepseek-v4.1-flash, deepseek-v3.2,
        //    deepseek-chat-v3.1 — đã thêm lại danh sách.
        "qwen/qwen3.8-max:free": { "name": "Qwen3.8 Max · 1M · vision/reasoning", "release_date": "2099-12-31" },
        "qwen/qwen3.7-plus:free": { "name": "Qwen3.7 Plus · 1M · vision", "release_date": "2099-12-29" },
        "qwen/qwen3.5-plus:free": { "name": "Qwen3.5 Plus · 1M · vision", "release_date": "2099-12-28" },
        "qwen/qwen3-coder-plus:free": { "name": "Qwen3 Coder Plus · 1M · code", "release_date": "2099-12-26" },
        "qwen/qwen3.5-397b-a17b:free": { "name": "Qwen3.5 397B-A17B · vision", "release_date": "2099-12-21" },
        "qwen/qwen3.6-35b-a3b:free": { "name": "Qwen3.6 35B-A3B · vision", "release_date": "2099-12-20" },
        "qwen/qwen3.6-max-preview:free": { "name": "Qwen3.6 Max Preview · reasoning", "release_date": "2099-12-19" },
        "qwen/qwen3.6-plus:free": { "name": "Qwen3.6 Plus · 1M · vision", "release_date": "2099-12-18" },
        "qwen/qwen3.6-27b:free": { "name": "Qwen3.6 27B · vision", "release_date": "2099-12-17" },
        "qwen/qwen3.5-flash:free": { "name": "Qwen3.5 Flash · 1M · fast/vision", "release_date": "2099-12-16" },
        "qwen/qwen3.7-flash:free": { "name": "Qwen3.7 Flash · 1M · vision", "release_date": "2099-12-15" },
        "qwen/qwen3.7-max:free": { "name": "Qwen3.7 Max · 1M · reasoning", "release_date": "2099-12-14" },
        "qwen/qwen3-max:free": { "name": "Qwen3 Max · vision", "release_date": "2099-12-13" },
        "qwen/qwen3.8-omni-flash:free": { "name": "Qwen3.8 Omni · 1M · omni", "release_date": "2099-12-12" },
        "qwen/qwen3.5-omni-plus:free": { "name": "Qwen3.5 Omni Plus · omni", "release_date": "2099-12-11" },
        "qwen/qwen3.5-omni-flash:free": { "name": "Qwen3.5 Omni Flash · omni", "release_date": "2099-12-10" },
        "qwen/qwen3-omni-flash:free": { "name": "Qwen3 Omni Flash · omni", "release_date": "2099-12-09" },
        "qwen/qwen3-vl-plus:free": { "name": "Qwen3 VL Plus · vision", "release_date": "2099-12-08" },
        "qwen/qwen-plus-2025-07-28:free": { "name": "Qwen Plus 0728 · vision", "release_date": "2099-12-07" },
        "mistralai/mistral-medium-3.5": { "name": "Mistral Medium 3.5 · 256K · reasoning", "release_date": "2099-12-06" },
        "mistralai/mistral-large-2512": { "name": "Mistral Large 3 · 256K · vision", "release_date": "2099-12-05" },
        "mistralai/mistral-small-2603": { "name": "Mistral Small 4 · vision", "release_date": "2099-12-04" },
        "mistralai/codestral-2508": { "name": "Codestral · code", "release_date": "2099-12-03" },
        "mistralai/devstral-medium": { "name": "Devstral 2 · dev/code", "release_date": "2099-12-02" },
        "mistralai/ministral-14b": { "name": "Ministral 14B · vision", "release_date": "2099-12-01" },
        "mistralai/ministral-8b": { "name": "Ministral 8B · vision", "release_date": "2099-11-30" },
        "mistralai/ministral-3b": { "name": "Ministral 3B · vision", "release_date": "2099-11-29" },
        "sensenova/sensenova-6.8-flash-lite": { "name": "SenseNova 6.8 · vision", "release_date": "2099-11-21" },
        "sensenova/sensenova-6.7-flash-lite": { "name": "SenseNova 6.7 · vision", "release_date": "2099-11-20" },
        "cohere/aya-expanse-32b": { "name": "🆕 Aya Expanse 32b · 128K", "release_date": "2099-11-19" },
        "cohere/aya-vision-32b": { "name": "🆕 Aya Vision 32b · 16.4K", "release_date": "2099-11-18" },
        "cohere/command-a": { "name": "🆕 Command A · 288K", "release_date": "2099-11-17" },
        "cohere/command-a-plus": { "name": "🆕 Command A Plus · 436K", "release_date": "2099-11-16" },
        "cohere/command-a-reasoning": { "name": "🆕 Command A Reasoning · 288.8K", "release_date": "2099-11-15" },
        "cohere/command-a-translate": { "name": "🆕 Command A Translate · 9K", "release_date": "2099-11-14" },
        "cohere/command-a-vision": { "name": "🆕 Command A Vision · 128K", "release_date": "2099-11-13" },
        "cohere/command-r-08-2024": { "name": "🆕 Command R 08 2024 · 128K", "release_date": "2099-11-12" },
        "cohere/command-r-plus-08-2024": { "name": "🆕 Command R Plus 08 2024 · 128K", "release_date": "2099-11-11" },
        "cohere/command-r7b-12-2024": { "name": "🆕 Command R7b 12 2024 · 132K", "release_date": "2099-11-10" },
        "cohere/north-mini-code": { "name": "🆕 North Mini Code · 256K", "release_date": "2099-11-09" },
        "cohere/north-small-translate": { "name": "🆕 North Small Translate · 32.8K", "release_date": "2099-11-08" },
        "cohere/tiny-aya-earth": { "name": "🆕 Tiny Aya Earth · 8.2K", "release_date": "2099-11-07" },
        "cohere/tiny-aya-fire": { "name": "🆕 Tiny Aya Fire · 8.2K", "release_date": "2099-11-06" },
        "cohere/tiny-aya-global": { "name": "🆕 Tiny Aya Global · 8.2K", "release_date": "2099-11-05" },
        "cohere/tiny-aya-water": { "name": "🆕 Tiny Aya Water · 8.2K", "release_date": "2099-11-04" },
        "dots-studio/dots-3-note-preview:free": { "name": "🆕 Dots 3 Note Preview · 512K", "release_date": "2099-11-03" },
        "inclusionai/ling-3.0-flash-sante:free": { "name": "🆕 Ling 3.0 Flash Sante · 262.1K", "release_date": "2099-11-02" },
        "liquid/lfm-2.5-2.6b:free": { "name": "🆕 Lfm 2.5 2.6b · 65.5K", "release_date": "2099-11-01" },
        "meituan/longcat-2.0": { "name": "🆕 Longcat 2.0 · 1M", "release_date": "2099-10-31" },
        "meituan/longcat-2.5-preview:free": { "name": "🆕 Longcat 2.5 Preview · 1M", "release_date": "2099-10-30" },
        "meta/muse-spark-1.2-contributor:free": { "name": "🆕 Muse Spark 1.2 Contributor · 1M", "release_date": "2099-10-29" },
        "meta/muse-spark-1.3-contributor:free": { "name": "🆕 Muse Spark 1.3 Contributor · 1M", "release_date": "2099-10-28" },
        "stealth/big-pickle": { "name": "🆕 Big Pickle · 200K", "release_date": "2099-10-27" },
        "stealth/space-bunny-alpha:free": { "name": "🆕 Space Bunny Alpha · 1M", "release_date": "2099-10-26" },
